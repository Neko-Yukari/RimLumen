{
  "id": "vibrant",
  "name": "Vibrant (霓虹高饱和)",
  "author": "RimLumen",
  "description": "保留高光色彩纯度（大幅抑制向白褪色）、强化色彩饱和与6级能量光晕；空载零开销，适合魔法、激光与科幻流派。",
  "runOnEmptyFrames": false,
  "requiresSceneDepth": false,
  "requiresMapLightField": false,
  "objectShadows": true,
  "bloomMipLevels": 6,
  "compositeShader": "Composite.frag.glsl",
  "options": [
    {
      "key": "bloomIntensity",
      "label": "霓虹泛光强度 (Bloom intensity)",
      "target": "bloomIntensity",
      "default": 0.28,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "bloomThreshold",
      "label": "起辉阈值 (Bloom threshold)",
      "target": "bloomThreshold",
      "default": 0.70,
      "min": 0.2,
      "max": 2.5,
      "step": 0.05
    },
    {
      "key": "saturationBoost",
      "label": "高光饱和度增强 (Chroma retention)",
      "target": "packParam0",
      "default": 0.75,
      "min": 0.0,
      "max": 1.5,
      "step": 0.02,
      "tooltip": "提高过曝核心的色相保留率并强化饱和度，避免强光褪成纯白。"
    },
    {
      "key": "exposureGain",
      "label": "能量曝光倍率 (Energy exposure)",
      "target": "packParam1",
      "default": 1.25,
      "min": 0.5,
      "max": 2.5,
      "step": 0.02
    }
  ]
}
