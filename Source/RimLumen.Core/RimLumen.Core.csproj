<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimLumen.Core</AssemblyName>
    <RootNamespace>RimLumen.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\1.7\Assemblies\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimLumenShipRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);RIMLUMEN_SHIP_RELEASE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(RimLumenShipRelease)' == 'true'">
    <Compile Remove="Rendering\Probes\**" />
    <Compile Remove="Showcase\**" />
    <Compile Remove="Rendering\Logic\ProbeOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>$(GameRoot)/RimWorld.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameRoot)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameRoot)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan">
      <HintPath>$(GameRoot)/Brutal.Vulkan.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan.Abstractions">
      <HintPath>$(GameRoot)/Brutal.Vulkan.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan.Vma">
      <HintPath>$(GameRoot)/Brutal.Vulkan.Vma.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Collections">
      <HintPath>$(GameRoot)/Brutal.Core.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Common">
      <HintPath>$(GameRoot)/Brutal.Core.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Strings">
      <HintPath>$(GameRoot)/Brutal.Core.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Interop">
      <HintPath>$(GameRoot)/Brutal.Interop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Texture">
      <HintPath>$(GameRoot)/Brutal.Texture.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Maths">
      <HintPath>$(GameRoot)/Brutal.Core.Maths.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Memory">
      <HintPath>$(GameRoot)/Brutal.Core.Memory.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(GameRoot)/Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Slang">
      <HintPath>$(GameRoot)/Brutal.Slang.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
